# Sarvam AI speech-to-text (required for voice input; text-only endpoint works without it)
SARVAM_API_KEY=

# Local generation model (downloaded from Hugging Face Hub on first run, then cached)
GEN_MODEL_REPO=Qwen/Qwen2.5-1.5B-Instruct

# Languages to index/serve (must match configs prepared via data/prepare_dataset.py)
RAG_LANGUAGES=hi,ta
